{
  "groups": {
    "type": "template_list",
    "description": "启用的群",
    "default": [],
    "hint": "按平台、机器人账号和群标识隔离。采集验证关闭后才注入上下文及接管记忆。",
    "templates": {
      "group": {
        "name": "群",
        "display_item": "umo",
        "items": {
          "umo": {
            "type": "string",
            "description": "群会话标识",
            "default": ""
          },
          "account": {
            "type": "string",
            "description": "机器人稳定账号（QQ 官方为 AppID）",
            "default": ""
          },
          "enabled": {
            "type": "bool",
            "description": "启用",
            "default": true
          },
          "capture_only": {
            "type": "bool",
            "description": "仅采集验证",
            "default": true
          },
          "interject_enabled": {
            "type": "bool",
            "description": "自然插话",
            "default": false
          },
          "video_sharing_enabled": {
            "type": "bool",
            "description": "分享 B 站视频到本群",
            "default": false,
            "hint": "从公开视频列表选材，由当前回复或插话决定是否分享短配文＋原链接；不登录 B 站、不在评论区发消息。"
          },
          "video_card_enabled": {
            "type": "bool",
            "description": "QQ 官方视频大图卡片（配文分开发送）",
            "default": false,
            "hint": "需 QQ 平台 ARK 权限及 B 站链接、封面域名许可。仅 QQ 官方适配器生效；失败或回执不明不自动补发。"
          },
          "video_topics": {
            "type": "list",
            "description": "视频选材关键词（标题、简介、分区；空列表不限）",
            "default": [
              "搞笑",
              "鬼畜",
              "抽象",
              "整活",
              "游戏",
              "动画",
              "动物"
            ]
          },
          "video_max_seconds": {
            "type": "int",
            "description": "候选视频最长秒数",
            "default": 300
          },
          "video_refresh_seconds": {
            "type": "int",
            "description": "公开视频列表刷新间隔（秒）",
            "default": 900
          },
          "video_candidate_minutes": {
            "type": "int",
            "description": "候选列表有效分钟数",
            "default": 60
          },
          "video_dedupe_days": {
            "type": "int",
            "description": "本群视频去重天数（1～90）",
            "default": 30
          },
          "stickers_enabled": {
            "type": "bool",
            "description": "群表情采集与发送",
            "default": false,
            "hint": "只采集本群实际收到的图片，按内容去重和频次入库；默认关闭。管理入口见插件 Pages 的 stickers。"
          },
          "stickers_top": {
            "type": "int",
            "description": "本群可用表情数量",
            "default": 100
          },
          "stickers_min_occurrences": {
            "type": "int",
            "description": "图片至少出现几次才审核入库",
            "default": 2
          },
          "stickers_quota_mb": {
            "type": "int",
            "description": "本群表情文件额度（MiB，16～512）",
            "default": 64
          },
          "stickers_caption_provider": {
            "type": "string",
            "description": "表情图片理解模型（留空沿用本群图片转述模型）",
            "default": ""
          },
          "style_excluded_senders": {
            "type": "list",
            "description": "其他机器人账号（不学口吻）",
            "default": [],
            "hint": "填写本群该平台下已确认的机器人稳定成员 ID；QQ 官方为成员 OpenID，OneBot 为 QQ 号。仍保留其近期消息理解现场，不按昵称猜测。"
          },
          "quota_mb": {
            "type": "float",
            "description": "本群额度（MiB，0 继承默认）",
            "default": 0
          },
          "limits": {
            "type": "object",
            "description": "本群参数",
            "items": {
              "quota_mb": {
                "type": "float",
                "description": "每群存储额度（MiB）",
                "default": 2
              },
              "compress_percent": {
                "type": "int",
                "description": "开始压缩占比（%）",
                "default": 80
              },
              "target_percent": {
                "type": "int",
                "description": "压缩目标占比（%）",
                "default": 45
              },
              "summary_chars": {
                "type": "int",
                "description": "滚动摘要字数",
                "default": 800
              },
              "preference_limit": {
                "type": "int",
                "description": "每人偏好条数",
                "default": 3
              },
              "fact_chars": {
                "type": "int",
                "description": "单条记忆字数",
                "default": 160
              },
              "batch_seconds": {
                "type": "int",
                "description": "记忆整理间隔（秒）",
                "default": 600
              },
              "batch_size": {
                "type": "int",
                "description": "每批记忆条数",
                "default": 32
              },
              "candidate_limit": {
                "type": "int",
                "description": "候选队列条数",
                "default": 128
              },
              "inactive_days": {
                "type": "int",
                "description": "普通成员过期天数",
                "default": 90
              },
              "topic_days": {
                "type": "int",
                "description": "普通话题过期天数",
                "default": 7
              },
              "raw_hours": {
                "type": "int",
                "description": "原始聊天保存小时（0 仅内存）",
                "default": 6
              },
              "raw_limit": {
                "type": "int",
                "description": "原始聊天最大条数",
                "default": 500
              },
              "recent_messages": {
                "type": "int",
                "description": "近期消息条数",
                "default": 24
              },
              "recent_minutes": {
                "type": "int",
                "description": "近期消息分钟数",
                "default": 20
              },
              "recent_chars": {
                "type": "int",
                "description": "近期消息字数",
                "default": 4500
              },
              "style_messages": {
                "type": "int",
                "description": "口吻样本条数",
                "default": 5
              },
              "style_minutes": {
                "type": "int",
                "description": "口吻样本分钟数",
                "default": 120
              },
              "style_per_sender": {
                "type": "int",
                "description": "每人口吻样本条数",
                "default": 4
              },
              "style_chars": {
                "type": "int",
                "description": "口吻样本字数",
                "default": 1800
              },
              "style_context_messages": {
                "type": "int",
                "description": "每个样本的邻近前话条数（0 关闭）",
                "default": 2
              },
              "style_context_seconds": {
                "type": "int",
                "description": "样本邻近前话最大间隔（秒）",
                "default": 30
              },
              "memory_chars": {
                "type": "int",
                "description": "记忆注入字数",
                "default": 1500
              },
              "stats_chars": {
                "type": "int",
                "description": "节奏统计字数",
                "default": 500
              },
              "pack_chars": {
                "type": "int",
                "description": "总上下文字数",
                "default": 8300
              },
              "interject_interval_seconds": {
                "type": "int",
                "description": "插话判断间隔（秒）",
                "default": 30
              },
              "interject_quiet_seconds": {
                "type": "int",
                "description": "插话等待安静（秒）",
                "default": 8
              },
              "interject_cooldown_seconds": {
                "type": "int",
                "description": "插话冷却（秒，可为 0）",
                "default": 30
              },
              "interject_fresh_seconds": {
                "type": "int",
                "description": "插话消息新鲜期（秒）",
                "default": 180
              },
              "interject_timeout_seconds": {
                "type": "int",
                "description": "插话模型超时（秒）",
                "default": 45
              },
              "interject_max_chars": {
                "type": "int",
                "description": "插话最大字数",
                "default": 240
              },
              "reply_fresh_seconds": {
                "type": "int",
                "description": "普通回复消息新鲜期（秒）",
                "default": 180
              },
              "reply_repair_timeout_seconds": {
                "type": "int",
                "description": "回复修正超时（秒）",
                "default": 30
              },
              "reply_segment_chars": {
                "type": "int",
                "description": "分条目标字数（0 关闭，代码和链接保持完整）",
                "default": 80
              },
              "reply_segment_interval_ms": {
                "type": "int",
                "description": "分条发送间隔（毫秒）",
                "default": 600
              },
              "alias_limit": {
                "type": "int",
                "description": "每人每类称呼上限（已确认、待确认、停用；1～12）",
                "default": 5
              },
              "alias_days": {
                "type": "int",
                "description": "已确认及待确认称呼保留天数（7～365）",
                "default": 90
              },
              "style_archive_limit": {
                "type": "int",
                "description": "每群保存的真人接话案例上限（0～200，0 关闭）",
                "default": 40
              },
              "style_archive_days": {
                "type": "int",
                "description": "真人接话案例保留天数（1～90）",
                "default": 30
              },
              "style_case_chars": {
                "type": "int",
                "description": "每组真人接话案例总字符上限（80～600）",
                "default": 320
              },
              "topic_minutes": {
                "type": "int",
                "description": "延后用途回答关联前话的最长分钟数（1～30）",
                "default": 15
              },
              "alias_context_messages": {
                "type": "int",
                "description": "外号学习每批消息条数",
                "default": 48
              },
              "alias_context_chars": {
                "type": "int",
                "description": "外号学习每批文字预算",
                "default": 8000
              },
              "alias_context_timeout_seconds": {
                "type": "int",
                "description": "后台外号学习超时（秒）",
                "default": 120
              },
              "alias_context_reviews": {
                "type": "int",
                "description": "每轮额外外号复核次数（0～6，不限制群聊回复）",
                "default": 2
              },
              "vision_timeout_seconds": {
                "type": "int",
                "description": "单张图片理解超时（秒）",
                "default": 35
              },
              "vision_wait_seconds": {
                "type": "int",
                "description": "普通回复等待读图的最长秒数",
                "default": 12
              },
              "vision_image_limit": {
                "type": "int",
                "description": "单条消息最多理解几张图",
                "default": 6
              },
              "vision_cache_limit": {
                "type": "int",
                "description": "每群短期图片说明条数",
                "default": 128
              },
              "vision_context_chars": {
                "type": "int",
                "description": "每次注入的图片说明字数预算",
                "default": 1800
              }
            }
          },
          "alias_context_enabled": {
            "type": "bool",
            "description": "从上下文学习外号",
            "default": true,
            "hint": "复用后台维护周期，批量核对真人的引用、称呼和上下句；推断与明确确认分开保存。"
          },
          "alias_context_fast": {
            "type": "bool",
            "description": "外号学习使用快速模式",
            "default": true,
            "hint": "DeepSeek 后台外号学习关闭思考模式以控制延迟；群聊回复仍沿用原模型设置。"
          },
          "vision_enabled": {
            "type": "bool",
            "description": "免 @ 理解群图片",
            "default": false,
            "hint": "后台提取短期图片说明，普通回复和插话共享；不代表每图必回，不自动建立人物事实。"
          },
          "vision_provider": {
            "type": "string",
            "description": "图片理解模型（留空沿用本群图片转述模型）",
            "default": ""
          }
        }
      }
    }
